# Modele de configuration pour la mise en ligne : copier en .env sur le serveur,
# remplir les valeurs marquees A REMPLIR, puis lancer :
#   php artisan key:generate
#   php artisan app:check-environment
# Ne jamais versionner le .env reel ni y copier ce fichier dans le depot.

APP_NAME=CIDST
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# A REMPLIR : adresse publique du site, en https.
APP_URL=https://votre-domaine.tld
APP_TIMEZONE=Indian/Antananarivo

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# A REMPLIR : base MySQL du serveur.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
# sync : traitement immediat, aucun worker a maintenir. Passer a database seulement si un worker tourne.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Courrier : Gmail SMTP avec un mot de passe d'application (jamais le mot de passe du compte).
# Le port 587 utilise STARTTLS automatiquement.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# A REMPLIR : l'adresse Gmail de l'organisation (expediteur = adresse du compte).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@votre-domaine.tld
MAIL_FROM_NAME=CIDST

PDF_THUMBNAIL_DRIVER=poppler
PDF_THUMBNAIL_POPPLER_BINARY=pdftoppm

# Passer en report-only seulement pour diagnostiquer un blocage.
CSP_MODE=enforce

CONTACT_IMAGES_RETENTION_DAYS=90
CONTACT_MESSAGES_RETENTION_DAYS=365
